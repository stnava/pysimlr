# Downloaded TCGA matrices, ~40 MB per cancer (154 MB for the six currently
# used). A reproducible cache, not source: `scripts/tcga_loader.py` re-fetches
# any missing file from the Xena TCGA hub on first use. Note the existing
# `*.csv` rule does not cover these -- they are .tsv and .gz, so without this
# `git add -A` would stage the lot.
data/tcga/

# UCI mfeat raw feature files (no extension, so no existing rule covers
# them) and the ADNI merge cache built by scripts/build_adni_*_cache.py --
# both reproducible from their loaders, not source.
data/mfeat/
data/adni/

# Quarto's rendered support assets for paper/index.qmd -- regenerated by
# `quarto render`, not source.
paper/site_libs/
